{
  "name": "equalizer19-vue",
  "version": "19.0.0",
  "type": "module",
  "description": "Professional 19-Band Audio Equalizer with Vue 3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --test \"tests/*.test.js\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.4",
    "terser": "^5.44.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
